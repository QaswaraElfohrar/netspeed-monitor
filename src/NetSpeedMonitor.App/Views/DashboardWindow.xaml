<Window x:Class="NetSpeedMonitor.App.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:NetSpeedMonitor.App.Services"
        xmlns:ctl="clr-namespace:NetSpeedMonitor.App.Controls"
        xmlns:loc="clr-namespace:NetSpeedMonitor.Core.Localization;assembly=NetSpeedMonitor.Core"
        Title="{l:T dash.title}" Width="780" Height="580" MinWidth="640" MinHeight="480"
        Icon="pack://application:,,,/Assets/app.ico"
        Style="{StaticResource AppWindow}" WindowStartupLocation="CenterScreen"
        FlowDirection="{Binding IsRtl, Source={x:Static loc:Loc.Instance}, Converter={StaticResource Rtl}}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <RadioButton GroupName="tabs" Style="{StaticResource NavButton}" IsChecked="{Binding IsLiveTab}" Content="{l:T tab.live}"/>
            <RadioButton GroupName="tabs" Style="{StaticResource NavButton}" IsChecked="{Binding IsUsageTab}" Content="{l:T tab.usage}" Margin="4,0,0,0"/>
            <RadioButton GroupName="tabs" Style="{StaticResource NavButton}" IsChecked="{Binding IsAdaptersTab}" Content="{l:T tab.adapters}" Margin="4,0,0,0"/>
        </StackPanel>

        <!-- ================= LIVE ================= -->
        <Grid Grid.Row="1" Visibility="{Binding IsLiveTab, Converter={StaticResource BoolVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <UniformGrid Columns="2">
                <Border Style="{StaticResource Card}" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="{l:T live.down}" Style="{StaticResource Subtle}"/>
                        <TextBlock Text="{Binding DownText}" Style="{StaticResource Num}" FontSize="30" FontWeight="SemiBold"
                                   Foreground="{DynamicResource DownBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="{l:T live.up}" Style="{StaticResource Subtle}"/>
                        <TextBlock Text="{Binding UpText}" Style="{StaticResource Num}" FontSize="30" FontWeight="SemiBold"
                                   Foreground="{DynamicResource UpBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{l:T graph.title}" Style="{StaticResource Subtle}" Margin="0,0,0,8"/>
                    <ctl:SpeedGraph x:Name="Graph" Grid.Row="1"/>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,12,10">
                        <TextBlock Text="{l:T live.totalDown}" Style="{StaticResource Subtle}"/>
                        <TextBlock Text="{Binding SessionDownText}" Style="{StaticResource Num}" FontWeight="SemiBold" Foreground="{DynamicResource DownBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,0,10">
                        <TextBlock Text="{l:T live.totalUp}" Style="{StaticResource Subtle}"/>
                        <TextBlock Text="{Binding SessionUpText}" Style="{StaticResource Num}" FontWeight="SemiBold" Foreground="{DynamicResource UpBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,0,12,0">
                        <TextBlock Text="{l:T live.adapter}" Style="{StaticResource Subtle}"/>
                        <TextBlock Text="{Binding AdapterText}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1">
                        <TextBlock Text="{l:T live.status}" Style="{StaticResource Subtle}"/>
                        <TextBlock FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{l:T status.disconnected}"/>
                                    <Setter Property="Foreground" Value="#E5534B"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Text" Value="{l:T status.connected}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource DownBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= USAGE ================= -->
        <Grid Grid.Row="1" Visibility="{Binding IsUsageTab, Converter={StaticResource BoolVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <UniformGrid Columns="4">
                <Border Style="{StaticResource Card}" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="{l:T usage.today}" Style="{StaticResource Subtle}"/>
                        <TextBlock Style="{StaticResource Num}" Foreground="{DynamicResource DownBrush}" FontWeight="SemiBold" FontSize="15" Margin="0,4,0,0"><Run Text="↓ "/><Run Text="{Binding TodayDown, Mode=OneWay}"/></TextBlock>
                        <TextBlock Style="{StaticResource Num}" Foreground="{DynamicResource UpBrush}" FontWeight="SemiBold" FontSize="15"><Run Text="↑ "/><Run Text="{Binding TodayUp, Mode=OneWay}"/></TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="3,0,3,0">
                    <StackPanel>
                        <TextBlock Text="{l:T usage.week}" Style="{StaticResource Subtle}"/>
                        <TextBlock Style="{StaticResource Num}" Foreground="{DynamicResource DownBrush}" FontWeight="SemiBold" FontSize="15" Margin="0,4,0,0"><Run Text="↓ "/><Run Text="{Binding WeekDown, Mode=OneWay}"/></TextBlock>
                        <TextBlock Style="{StaticResource Num}" Foreground="{DynamicResource UpBrush}" FontWeight="SemiBold" FontSize="15"><Run Text="↑ "/><Run Text="{Binding WeekUp, Mode=OneWay}"/></TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="3,0,3,0">
                    <StackPanel>
                        <TextBlock Text="{l:T usage.month}" Style="{StaticResource Subtle}"/>
                        <TextBlock Style="{StaticResource Num}" Foreground="{DynamicResource DownBrush}" FontWeight="SemiBold" FontSize="15" Margin="0,4,0,0"><Run Text="↓ "/><Run Text="{Binding MonthDown, Mode=OneWay}"/></TextBlock>
                        <TextBlock Style="{StaticResource Num}" Foreground="{DynamicResource UpBrush}" FontWeight="SemiBold" FontSize="15"><Run Text="↑ "/><Run Text="{Binding MonthUp, Mode=OneWay}"/></TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="{l:T usage.total}" Style="{StaticResource Subtle}"/>
                        <TextBlock Style="{StaticResource Num}" Foreground="{DynamicResource DownBrush}" FontWeight="SemiBold" FontSize="15" Margin="0,4,0,0"><Run Text="↓ "/><Run Text="{Binding TotalDown, Mode=OneWay}"/></TextBlock>
                        <TextBlock Style="{StaticResource Num}" Foreground="{DynamicResource UpBrush}" FontWeight="SemiBold" FontSize="15"><Run Text="↑ "/><Run Text="{Binding TotalUp, Mode=OneWay}"/></TextBlock>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{l:T usage.daily}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Grid Grid.Row="1" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{l:T usage.date}" Style="{StaticResource Subtle}"/>
                        <TextBlock Grid.Column="1" Text="{l:T live.down}" Style="{StaticResource Subtle}"/>
                        <TextBlock Grid.Column="2" Text="{l:T live.up}" Style="{StaticResource Subtle}"/>
                        <TextBlock Grid.Column="3" Text="{l:T usage.sum}" Style="{StaticResource Subtle}"/>
                    </Grid>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Daily}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Date}" Style="{StaticResource Num}" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Down}" Style="{StaticResource Num}" HorizontalAlignment="Left" Foreground="{DynamicResource DownBrush}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Up}" Style="{StaticResource Num}" HorizontalAlignment="Left" Foreground="{DynamicResource UpBrush}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Sum}" Style="{StaticResource Num}" HorizontalAlignment="Left"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= ADAPTERS ================= -->
        <Grid Grid.Row="1" Visibility="{Binding IsAdaptersTab, Converter={StaticResource BoolVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <RadioButton GroupName="adp" IsChecked="{Binding IsAuto, Mode=TwoWay}" Content="{l:T adapters.auto}" FontWeight="SemiBold"/>
                    <TextBlock Text="{l:T adapters.autoHint}" Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="22,4,0,0"/>
                </StackPanel>
            </Border>
            <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Adapters}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <RadioButton GroupName="adp" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <StackPanel Grid.Column="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Tags}" Style="{StaticResource Subtle}" Margin="8,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Subtle}" TextTrimming="CharacterEllipsis" FontSize="11.5"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" Margin="12,0,0,0">
                                        <TextBlock Text="{Binding Status}" HorizontalAlignment="Right" Style="{StaticResource Subtle}"/>
                                        <TextBlock Text="{Binding Speed}" Style="{StaticResource Num}" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
