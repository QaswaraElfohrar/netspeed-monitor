<Window x:Class="NetSpeedMonitor.App.Views.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetSpeed Monitor"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" WindowStartupLocation="Manual" Left="-32000" Top="-32000"
        FlowDirection="LeftToRight" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale">
    <Border Background="{Binding WidgetBackground}" CornerRadius="5" Padding="6,1">
        <StackPanel x:Name="Panel" Orientation="{Binding WidgetOrientation}" VerticalAlignment="Center">
            <TextBlock x:Name="DownBlock" Text="{Binding DownText}" Foreground="{Binding DownBrush}"
                       FontFamily="{Binding WidgetFont}" FontSize="{Binding WidgetFontSize}"
                       Visibility="{Binding DownVisibility}" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBlock x:Name="UpBlock" Text="{Binding UpText}" Foreground="{Binding UpBrush}"
                       FontFamily="{Binding WidgetFont}" FontSize="{Binding WidgetFontSize}"
                       Visibility="{Binding UpVisibility}" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>
