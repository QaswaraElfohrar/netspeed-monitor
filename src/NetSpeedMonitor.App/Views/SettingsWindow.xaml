<Window x:Class="NetSpeedMonitor.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:NetSpeedMonitor.App.Services"
        xmlns:loc="clr-namespace:NetSpeedMonitor.Core.Localization;assembly=NetSpeedMonitor.Core"
        Title="{l:T set.title}" Width="640" Height="560" MinWidth="560" MinHeight="480"
        Icon="pack://application:,,,/Assets/app.ico"
        Style="{StaticResource AppWindow}" WindowStartupLocation="CenterScreen"
        FlowDirection="{Binding IsRtl, Source={x:Static loc:Loc.Instance}, Converter={StaticResource Rtl}}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Margin="0,0,14,0">
            <RadioButton GroupName="s" Style="{StaticResource NavButton}" IsChecked="{Binding IsGeneral}" Content="{l:T set.general}" Margin="0,0,0,4"/>
            <RadioButton GroupName="s" Style="{StaticResource NavButton}" IsChecked="{Binding IsAppearance}" Content="{l:T set.appearance}" Margin="0,0,0,4"/>
            <RadioButton GroupName="s" Style="{StaticResource NavButton}" IsChecked="{Binding IsMonitoring}" Content="{l:T set.monitoring}" Margin="0,0,0,4"/>
            <RadioButton GroupName="s" Style="{StaticResource NavButton}" IsChecked="{Binding IsPosition}" Content="{l:T set.position}"/>
        </StackPanel>

        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="18,14">
            <Grid>
                <!-- ============ GENERAL ============ -->
                <ScrollViewer Visibility="{Binding IsGeneral, Converter={StaticResource BoolVis}}" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{l:T set.language}" Style="{StaticResource Subtle}" Margin="0,0,0,4"/>
                        <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding Language}" Margin="0,0,0,14">
                            <ComboBoxItem Tag="system" Content="{l:T lang.system}"/>
                            <ComboBoxItem Tag="en" Content="English"/>
                            <ComboBoxItem Tag="ar" Content="العربية"/>
                            <ComboBoxItem Tag="fr" Content="Français"/>
                        </ComboBox>
                        <CheckBox IsChecked="{Binding StartWithWindows}" Content="{l:T set.startWithWindows}"/>
                        <CheckBox IsChecked="{Binding StartMinimized}" Content="{l:T set.startMinimized}"/>
                        <CheckBox IsChecked="{Binding MinimizeToTray}" Content="{l:T set.minimizeToTray}"/>
                        <CheckBox IsChecked="{Binding DashboardOnDoubleClick}" Content="{l:T set.dblClick}"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ APPEARANCE ============ -->
                <ScrollViewer Visibility="{Binding IsAppearance, Converter={StaticResource BoolVis}}" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{l:T set.theme}" Style="{StaticResource Subtle}" Margin="0,0,0,4"/>
                        <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding Theme}" Margin="0,0,0,12">
                            <ComboBoxItem Tag="system" Content="{l:T theme.system}"/>
                            <ComboBoxItem Tag="dark" Content="{l:T theme.dark}"/>
                            <ComboBoxItem Tag="light" Content="{l:T theme.light}"/>
                        </ComboBox>

                        <TextBlock Text="{l:T set.font}" Style="{StaticResource Subtle}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Fonts}" SelectedItem="{Binding FontFamily}" Margin="0,0,0,12"/>

                        <TextBlock Style="{StaticResource Subtle}" Margin="0,0,0,4"><Run Text="{l:T set.fontSize}"/><Run Text=": "/><Run Text="{Binding FontSize, Mode=OneWay}"/></TextBlock>
                        <Slider Minimum="8" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding FontSize}" Margin="0,0,0,12" FlowDirection="LeftToRight"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{l:T set.downColor}" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Width="28" Height="20" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource LineBrush}" Background="{Binding DownloadSwatch}" Margin="8,0"/>
                            <Button Grid.Column="2" Content="{l:T btn.choose}" Command="{Binding PickColorCommand}" CommandParameter="down"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{l:T set.upColor}" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Width="28" Height="20" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource LineBrush}" Background="{Binding UploadSwatch}" Margin="8,0"/>
                            <Button Grid.Column="2" Content="{l:T btn.choose}" Command="{Binding PickColorCommand}" CommandParameter="up"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{l:T set.bgColor}" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Width="28" Height="20" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource LineBrush}" Background="{Binding BackgroundSwatch}" Margin="8,0"/>
                            <Button Grid.Column="2" Content="{l:T btn.choose}" Command="{Binding PickColorCommand}" CommandParameter="bg" Margin="0,0,6,0"/>
                            <Button Grid.Column="3" Content="{l:T btn.default}" Command="{Binding ClearBackgroundCommand}"/>
                        </Grid>

                        <CheckBox IsChecked="{Binding TransparentBackground}" Content="{l:T set.transparent}"/>
                        <TextBlock Style="{StaticResource Subtle}" Margin="0,6,0,4"><Run Text="{l:T set.opacity}"/><Run Text=": "/><Run Text="{Binding OpacityText, Mode=OneWay}"/></TextBlock>
                        <Slider Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding BackgroundOpacity}"
                                IsEnabled="{Binding OpacityEnabled}" Margin="0,0,0,12" FlowDirection="LeftToRight"/>

                        <TextBlock Text="{l:T set.layout}" Style="{StaticResource Subtle}" Margin="0,0,0,4"/>
                        <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding Layout}" Margin="0,0,0,12">
                            <ComboBoxItem Tag="horizontal" Content="{l:T layout.h}"/>
                            <ComboBoxItem Tag="vertical" Content="{l:T layout.v}"/>
                        </ComboBox>

                        <TextBlock Text="{l:T set.width}" Style="{StaticResource Subtle}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding WidgetWidth, UpdateSourceTrigger=LostFocus}" Width="100" HorizontalAlignment="Left" FlowDirection="LeftToRight"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ MONITORING ============ -->
                <ScrollViewer Visibility="{Binding IsMonitoring, Converter={StaticResource BoolVis}}" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{l:T set.refresh}" Style="{StaticResource Subtle}" Margin="0,0,0,4"/>
                        <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding RefreshText}" Margin="0,0,0,12">
                            <ComboBoxItem Tag="500" Content="500 ms"/>
                            <ComboBoxItem Tag="1000" Content="1000 ms"/>
                            <ComboBoxItem Tag="2000" Content="2000 ms"/>
                        </ComboBox>

                        <CheckBox IsChecked="{Binding AutoAdapter}" Content="{l:T set.adapterAuto}"/>
                        <TextBlock Text="{l:T set.adapter}" Style="{StaticResource Subtle}" Margin="0,6,0,4"/>
                        <ComboBox ItemsSource="{Binding Adapters}" DisplayMemberPath="Display" SelectedValuePath="Id"
                                  SelectedValue="{Binding AdapterId}" IsEnabled="{Binding ManualAdapterEnabled}" Margin="0,0,0,12"/>

                        <TextBlock Text="{l:T set.unit}" Style="{StaticResource Subtle}" Margin="0,0,0,4"/>
                        <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding Unit}" Margin="0,0,0,12">
                            <ComboBoxItem Tag="bytes" Content="{l:T unit.bytes}"/>
                            <ComboBoxItem Tag="bits" Content="{l:T unit.bits}"/>
                        </ComboBox>

                        <TextBlock Style="{StaticResource Subtle}" Margin="0,0,0,4"><Run Text="{l:T set.precision}"/><Run Text=": "/><Run Text="{Binding Precision, Mode=OneWay}"/></TextBlock>
                        <Slider Minimum="0" Maximum="3" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Precision}" Margin="0,0,0,12" FlowDirection="LeftToRight"/>

                        <CheckBox IsChecked="{Binding ShowDownload}" Content="{l:T set.showDown}"/>
                        <CheckBox IsChecked="{Binding ShowUpload}" Content="{l:T set.showUp}"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ POSITION ============ -->
                <ScrollViewer Visibility="{Binding IsPosition, Converter={StaticResource BoolVis}}" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <CheckBox IsChecked="{Binding AutoPosition}" Content="{l:T set.autoPos}"/>
                        <CheckBox IsChecked="{Binding LockPosition}" Content="{l:T set.lockPos}"/>
                        <CheckBox IsChecked="{Binding AlwaysOnTop}" Content="{l:T set.alwaysTop}"/>
                        <TextBlock Text="{l:T set.posHint}" Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,8,0,12"/>
                        <StackPanel IsEnabled="{Binding ManualPositionEnabled}">
                            <TextBlock Text="{l:T set.posX}" Style="{StaticResource Subtle}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding ManualX, UpdateSourceTrigger=LostFocus}" Width="100" HorizontalAlignment="Left" FlowDirection="LeftToRight" Margin="0,0,0,10"/>
                            <TextBlock Text="{l:T set.posY}" Style="{StaticResource Subtle}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding ManualY, UpdateSourceTrigger=LostFocus}" Width="100" HorizontalAlignment="Left" FlowDirection="LeftToRight"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{l:T btn.ok}" Command="{Binding OkCommand}" IsDefault="True"/>
            <Button Content="{l:T btn.cancel}" Command="{Binding CancelCommand}" IsCancel="True" Margin="8,0,0,0"/>
            <Button Content="{l:T btn.apply}" Command="{Binding ApplyCommand}" Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
